# Admin / demo accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
GUEST_USERNAME=guest
GUEST_PASSWORD=

# Encryption and legacy/admin ingest
APP_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
INGEST_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_OTHER_RANDOM_CHARACTERS

# LINE Messaging API + LINE Login (server-side only)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Turso / libSQL for Vercel
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development only
DB_PATH=./data/health.sqlite
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Vercel auto-infers this. Set only for a custom production origin.
APP_ORIGIN=
