# Keep the real values from your existing 2.0 .env. Never commit this file with real secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
GUEST_USERNAME=guest
GUEST_PASSWORD=
APP_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
INGEST_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_OTHER_RANDOM_CHARACTERS
# Messaging API sender credential. Keep this secret; never expose it in the browser.
LINE_CHANNEL_ACCESS_TOKEN=
# Required for LINE Login QR authentication/binding. Create a LINE Login channel under the same Provider as Messaging API.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Vercel: required. Use a remote libSQL database, NOT a file URL or local replica.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=REPLACE_WITH_DATABASE_TOKEN
# On Vercel this can be blank; the project domain is inferred. Set for a custom domain.
APP_ORIGIN=
# Local development only (ignored for persistence when TURSO_DATABASE_URL is set).
DB_PATH=./data/health.sqlite
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
